    {
      "name": "Get Single Block",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/blocks/minecraft:dirt",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "blocks",
            "minecraft:dirt"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Test success (Status 200 ou 404 si non trouvé)\", function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 404]);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Create Block (POST)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"key_name\": \"test_block\",\n    \"name\": \"Test Block\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/blocks",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "blocks"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Test success (Status 401 car pas de token)\", function () {",
              "    pm.response.to.have.status(401);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
