# Le nom de domaine (ou localhost en dev)
{$DOMAIN_NAME:localhost} {
    # Dossier où les fichiers buildés de l'application sont servis
    root * /srv
    
    # Gestion du routage SPA (Single Page Application)
    try_files {path} {path}/ {path}.html /index.html
    file_server

    # Reverse proxy vers le backend Express pour toutes les routes API et auth
    reverse_proxy /api/* http://express-api:8080
    reverse_proxy /login* http://express-api:8080
    reverse_proxy /register* http://express-api:8080
    reverse_proxy /logout* http://express-api:8080
    reverse_proxy /auth* http://express-api:8080
    reverse_proxy /api-docs* http://express-api:8080
    reverse_proxy /health* http://express-api:8080
}
