# Le nom de domaine (ou localhost en dev)
{$DOMAIN_NAME:localhost} {
    # Dossier où les fichiers buildés de l'application sont servis
    root * /srv
    
    # Serve backend API routes first
    handle /api/* {
        reverse_proxy http://express-api:8080
    }
    handle /login* {
        reverse_proxy http://express-api:8080
    }
    handle /register* {
        reverse_proxy http://express-api:8080
    }
    handle /logout* {
        reverse_proxy http://express-api:8080
    }
    handle /auth* {
        reverse_proxy http://express-api:8080
    }
    handle /api-docs* {
        reverse_proxy http://express-api:8080
    }
    handle /health* {
        reverse_proxy http://express-api:8080
    }

    # Match everything else and handle SPA routing
    handle {
        try_files {path} {path}/ {path}.html /index.html
        file_server
    }
}
