# Le nom de domaine (ou localhost en dev)
{$DOMAIN_NAME:localhost} {
    # Dossier où les fichiers buildés de l'application sont servis
    root * /srv
    
    # Routes strictly for the backend API
    handle /api/* {
        reverse_proxy http://express-api:8080
    }
    handle /api-docs* {
        reverse_proxy http://express-api:8080
    }
    handle /health* {
        reverse_proxy http://express-api:8080
    }
    handle /auth* {
        reverse_proxy http://express-api:8080
    }

    # API calls for login/register/logout are POST only
    @api_post_auth {
        method POST
        path /login /register /logout
    }
    handle @api_post_auth {
        reverse_proxy http://express-api:8080
    }

    # Match everything else and handle SPA routing
    handle {
        try_files {path} {path}/ {path}.html /index.html
        file_server
    }
}
